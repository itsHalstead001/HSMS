<%- include('partials/header') %>
<section class="login-layout">
  <div class="login-intro">
    <span class="eyebrow">A steady hand for the work you do together</span>
    <h1>Good records.<br><em>Stronger groups.</em></h1>
    <p>One calm place to care for your members, meetings and shared resources.</p>
    <div class="login-note"><span class="note-icon">✳</span><span><strong>Made for your group</strong><br>Simple tools for the everyday work that keeps a community moving.</span></div>
  </div>
  <section class="login-card">
    <span class="eyebrow">Welcome back</span>
    <h2>Sign in to your account</h2>
    <p class="muted">Use the account provided by your group chairperson.</p>
    <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
    <form action="/login" method="post" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="username">Username</label>
      <input id="username" name="username" type="text" autocomplete="username" required maxlength="80" autofocus>
      <label for="password">Password</label>
      <div class="password-input-wrap"><input id="password" name="password" type="password" autocomplete="current-password" required><button class="password-toggle" type="button" data-password-toggle aria-controls="password" aria-pressed="false">Show</button></div>
      <button class="button button-primary button-wide" type="submit">Sign in <span aria-hidden="true">→</span></button>
    </form>
    <p class="login-security"><span aria-hidden="true">●</span> Your group records are protected.</p>
  </section>
</section>
<%- include('partials/footer') %>
