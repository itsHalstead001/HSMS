<%- include('../partials/header') %>
<section class="page-heading"><div><span class="eyebrow">Application changes</span><h1>Update loan</h1><p>Only pending or approved loans that have not been disbursed can be changed. Edited approved loans return to pending review.</p></div><a class="button button-secondary" href="<%= subgroup ? '/subgroup/loans' : '/finance/loans' %>">← Back to loans</a></section>
<form class="panel form-panel narrow-panel" action="<%= subgroup ? `/subgroup/loans/${loan.id}/edit` : `/finance/loans/${loan.id}/edit` %>" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-field"><label for="member_id">Member <span class="required">*</span></label><select id="member_id" name="member_id" required><% members.forEach((member) => { %><option value="<%= member.id %>" <%= String(member.id) === String(loan.member_id) ? 'selected' : '' %>><%= member.full_name %><%= member.status === 'inactive' ? ' (inactive)' : '' %></option><% }) %></select></div>
  <div class="form-field"><label for="amount">Principal (<%= currency %>) <span class="required">*</span></label><input id="amount" name="amount" type="number" min="0.01" max="9999999999" step="0.01" value="<%= Number(loan.amount).toFixed(2) %>" required></div>
  <div class="form-field"><label for="term_months">Repayment term <span class="required">*</span></label><select id="term_months" name="term_months" required><% [3, 6, 9, 12, 18, 24, 36].forEach((term) => { %><option value="<%= term %>" <%= Number(loan.term_months) === term ? 'selected' : '' %>><%= term %> months</option><% }) %></select><small>Interest remains at the approved group rate of <%= Number(loan.interest_rate).toFixed(2) %>% per year.</small></div>
  <div class="form-field"><label for="purpose">Purpose <span class="required">*</span></label><textarea id="purpose" name="purpose" rows="3" maxlength="500" required><%= loan.purpose %></textarea></div>
  <div class="form-actions"><a class="button button-secondary" href="<%= subgroup ? '/subgroup/loans' : '/finance/loans' %>">Cancel</a><button class="button button-primary" type="submit">Save loan changes</button></div>
</form>
<%- include('../partials/footer') %>
