<%- include('../partials/header') %>
<section class="page-heading"><div><span class="eyebrow">Loan #<%= loan.id %></span><h1>Repayment schedule</h1><p><%= loan.full_name %> · Outstanding <strong><%= currency || 'KES' %> <%= Number(loan.balance).toLocaleString('en', { minimumFractionDigits: 2 }) %></strong></p></div><a class="button button-secondary" href="<%= subgroup ? '/subgroup/loans' : '/finance/loans' %>">← Back to loans</a></section>
<section class="panel">
  <% if (schedule.length) { %><div class="table-wrap"><table><thead><tr><th>Installment</th><th>Due date</th><th>Due</th><th>Paid</th><th>Remaining</th><th>Status</th></tr></thead><tbody><% schedule.forEach((item) => { %><tr><td>#<%= item.installment_number %></td><td><%= new Date(item.due_date).toLocaleDateString() %></td><td class="money"><%= currency || 'KES' %> <%= Number(item.amount_due).toLocaleString('en', { minimumFractionDigits: 2 }) %></td><td class="money"><%= currency || 'KES' %> <%= Number(item.amount_paid).toLocaleString('en', { minimumFractionDigits: 2 }) %></td><td class="money"><%= currency || 'KES' %> <%= Math.max(0, Number(item.amount_due) - Number(item.amount_paid)).toLocaleString('en', { minimumFractionDigits: 2 }) %></td><td><span class="status-badge <%= Number(item.amount_paid) >= Number(item.amount_due) ? 'status-active' : new Date(item.due_date) < new Date() ? 'status-rejected' : 'status-pending' %>"><%= Number(item.amount_paid) >= Number(item.amount_due) ? 'Paid' : new Date(item.due_date) < new Date() ? 'Due' : 'Upcoming' %></span></td></tr><% }) %></tbody></table></div><% } else { %><p class="quiet-empty">A repayment schedule will be available once this loan is disbursed.</p><% } %>
</section>
<%- include('../partials/footer') %>
