<%- include('../partials/header') %>
<section class="page-heading"><div><span class="eyebrow">Clarity builds confidence</span><h1>Financial reports</h1><p>A transparent view of recorded money in, money out and outstanding lending.</p></div><a class="button button-secondary" href="/finance/reports.csv">↓ Export ledger CSV</a></section>
<section class="panel">
  <div class="panel-heading"><div><span class="eyebrow">All recorded activity</span><h2>By transaction type</h2></div></div>
  <% if (totals.length) { %><div class="summary-pills"><% totals.forEach((row) => { %><div class="summary-pill"><span><%= row.transaction_type.replace(/_/g, ' ') %></span><strong><%= currency || 'KES' %> <%= Number(row.total).toLocaleString('en', { minimumFractionDigits: 2 }) %></strong><small><%= row.count %> entries</small></div><% }) %></div><% } else { %><p class="quiet-empty">There are no ledger entries yet.</p><% } %>
</section>
<section class="panel report-panel">
  <div class="panel-heading"><div><span class="eyebrow">Current loan book</span><h2>Loan status</h2></div><a class="text-link" href="/finance/loans">Manage loans →</a></div>
  <% if (loanTotals.length) { %><div class="table-wrap"><table><thead><tr><th>Status</th><th>Number of loans</th><th>Outstanding balance</th></tr></thead><tbody><% loanTotals.forEach((loan) => { %><tr><td><span class="status-badge status-<%= loan.status %>"><%= loan.status %></span></td><td><%= loan.count %></td><td class="money"><%= currency || 'KES' %> <%= Number(loan.balance).toLocaleString('en', { minimumFractionDigits: 2 }) %></td></tr><% }) %></tbody></table></div><% } else { %><p class="quiet-empty">No loans recorded.</p><% } %>
</section>
<section class="panel report-panel">
  <div class="panel-heading"><div><span class="eyebrow">Audit trail</span><h2>Recent ledger entries</h2></div></div>
  <% if (transactions.length) { %><div class="table-wrap"><table><thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Recorded by</th><th>Amount</th></tr></thead><tbody><% transactions.forEach((item) => { %><tr><td><%= new Date(item.transaction_date).toLocaleString('en', { dateStyle: 'medium', timeStyle: 'short' }) %></td><td><span class="type-label"><%= item.transaction_type.replace(/_/g, ' ') %></span></td><td><%= item.description %></td><td><%= item.recorded_by || 'Former user' %></td><td class="money"><%= ['expense','loan_disbursement'].includes(item.transaction_type) ? '−' : '+' %><%= currency || 'KES' %> <%= Number(item.amount).toLocaleString('en', { minimumFractionDigits: 2 }) %></td></tr><% }) %></tbody></table></div><% } else { %><p class="quiet-empty">Your ledger is ready for its first entry.</p><% } %>
</section>
<form class="panel form-panel expense-form" action="/finance/expenses" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><div><span class="eyebrow">Record spending</span><h2>New group expense</h2></div>
  <div class="form-field"><label for="expense-description">What was it for?</label><input id="expense-description" name="description" maxlength="500" required></div>
  <div class="form-field"><label for="expense-amount">Amount (<%= currency || 'KES' %>)</label><input id="expense-amount" name="amount" type="number" min="0.01" max="9999999999" step="0.01" required></div>
  <button class="button button-primary" type="submit">Record expense</button>
</form>
<%- include('../partials/footer') %>
