<%- include('../partials/header') %>
<section class="page-heading"><div><span class="eyebrow">Plan time together</span><h1>Meetings</h1><p>Keep dates, attendance and decisions in one place.</p></div><a class="button button-primary" href="/meetings/new">＋ Schedule meeting</a></section>
<section class="panel">
  <% if (meetings.length) { %><div class="table-wrap"><table><thead><tr><th>Meeting</th><th>Date and time</th><th>Attendance</th><th></th></tr></thead><tbody><% meetings.forEach((meeting) => { %><tr><td><a class="member-name" href="/meetings/<%= meeting.id %>"><%= meeting.title %></a><% if (meeting.description) { %><small class="cell-sub"><%= meeting.description %></small><% } %></td><td><%= new Date(meeting.meeting_date).toLocaleString('en', { dateStyle: 'medium', timeStyle: 'short' }) %></td><td><%= meeting.attendees %> present</td><td><a class="text-link" href="/meetings/<%= meeting.id %>">Open →</a></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state compact"><span class="empty-icon">◷</span><h2>No meetings yet</h2><p>Schedule a date to get the next conversation started.</p><a class="button button-primary" href="/meetings/new">Schedule a meeting</a></div><% } %>
</section>
<%- include('../partials/footer') %>
