<%- include('../partials/header') %>
<section class="page-heading"><div><span class="eyebrow">The people who keep things moving</span><h1>User accounts</h1><p>Create, reset access for, deactivate or remove group officer accounts. Existing passwords are never viewable.</p></div></section>
<div class="finance-grid">
  <section class="panel">
    <div class="panel-heading"><div><span class="eyebrow">Officer access</span><h2>Group accounts</h2></div></div>
    <div class="table-wrap"><table><thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Subgroup</th><th>Status</th><th>Account actions</th></tr></thead><tbody><% users.forEach((account) => { %><tr><td><strong><%= account.full_name %></strong></td><td><%= account.username %></td><td><%= roles[account.role] %></td><td><%= ['subgroup_chairperson', 'subgroup_secretary'].includes(account.role) ? `Subgroup ${account.subgroup_code || 'unassigned'}` : '—' %></td><td><span class="status-badge <%= account.is_active ? 'status-active' : 'status-inactive' %>"><%= account.is_active ? 'Active' : 'Inactive' %></span></td><td class="user-actions"><% if (String(account.id) === String(user.id)) { %><span class="muted small-copy">Current account</span><% } else { %><form action="/users/<%= account.id %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="is_active" value="<%= account.is_active ? '0' : '1' %>"><button class="text-button" type="submit"><%= account.is_active ? 'Deactivate' : 'Reactivate' %></button></form><form action="/users/<%= account.id %>/password" method="post" class="user-reset-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="reset-password-<%= account.id %>">Set a new password for <%= account.full_name %></label><div class="password-input-wrap"><input id="reset-password-<%= account.id %>" name="new_password" type="password" minlength="12" maxlength="72" placeholder="New password" required autocomplete="new-password"><button class="password-toggle" type="button" data-password-toggle aria-controls="reset-password-<%= account.id %>" aria-pressed="false">Show</button></div><button class="text-button" type="submit">Reset password</button></form><form action="/users/<%= account.id %>/delete" method="post" data-confirm="Permanently delete this officer account? Existing records will remain, but the account will be removed and its sessions revoked."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button text-danger" type="submit">Delete account</button></form><% } %></td></tr><% }) %></tbody></table></div>
  </section>
  <form class="panel form-panel" action="/users" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="eyebrow">Add an officer</span><h2>Create account</h2>
    <div class="form-field"><label for="full_name">Full name <span class="required">*</span></label><input id="full_name" name="full_name" maxlength="160" required autocomplete="name"></div>
    <div class="form-field"><label for="username">Username <span class="required">*</span></label><input id="username" name="username" maxlength="80" pattern="[a-zA-Z0-9._-]{3,80}" required autocomplete="off"><small>3–80 letters, numbers, dots, dashes or underscores.</small></div>
    <div class="form-field"><label for="role">Role <span class="required">*</span></label><select id="role" name="role" required><option value="">Choose a role</option><option value="secretary">Membership Secretary</option><option value="financial_secretary">Financial Secretary</option><option value="treasurer">Treasurer</option><option value="subgroup_chairperson">Subgroup Chairperson</option><option value="subgroup_secretary">Subgroup Secretary</option></select></div>
    <div class="form-field" data-subgroup-field hidden><label for="subgroup_code">Assigned subgroup <span class="required">*</span></label><select id="subgroup_code" name="subgroup_code"><option value="">Choose subgroup A–D</option><% subgroups.forEach((subgroup) => { %><option value="<%= subgroup.code %>"><%= subgroup.name %></option><% }) %></select></div>
    <div class="form-field"><label for="password">Temporary password <span class="required">*</span></label><div class="password-input-wrap"><input id="password" name="password" type="password" minlength="12" maxlength="72" required autocomplete="new-password" data-password-strength><button class="password-toggle" type="button" data-password-toggle aria-controls="password" aria-pressed="false">Show</button></div><div class="password-strength" aria-live="polite"><div class="password-strength-track"><span data-strength-meter></span></div><small data-strength-label>Enter a password to check its strength.</small></div><small>At least 12 characters and no more than 72 UTF-8 bytes. Share it privately.</small></div>
    <button class="button button-primary" type="submit">Create account</button>
  </form>
</div>
<%- include('../partials/footer') %>
