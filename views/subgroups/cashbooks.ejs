<%- include('../partials/header') %>
<section class="page-heading">
  <div><span class="eyebrow">Subgroup <%= subgroupCode %></span><h1>Member collections</h1><p>Update member meeting records, process subgroup loans and submit the calculated totals to the Financial Secretary.</p></div>
  <div class="report-tools"><form class="report-period-form" action="/subgroup/cashbook/report.pdf" method="get"><div class="report-period-field"><label for="subgroup-report-period">Report period</label><select id="subgroup-report-period" name="period"><option value="weekly">Weekly</option><option value="monthly">Monthly</option><option value="quarterly">Quarterly</option><option value="yearly">Yearly</option></select></div><div class="report-period-field"><label for="subgroup-report-date">Period containing</label><input id="subgroup-report-date" name="date" type="date" value="<%= reportDate %>" required></div><button class="button button-primary button-small" type="submit">Download PDF</button></form><a class="button button-secondary" href="/subgroup/loans">Process subgroup loans</a></div>
</section>
<section class="panel">
  <div class="panel-heading"><div><span class="eyebrow">Weekly submissions</span><h2>Recent and upcoming meetings</h2></div></div>
  <% if (meetings.length) { %>
    <div class="table-wrap"><table><thead><tr><th>Meeting</th><th>Date</th><th>Submission status</th><th>Last updated</th><th></th></tr></thead><tbody>
      <% meetings.forEach((meeting) => { %><tr>
        <td><strong><%= meeting.title %></strong></td>
        <td><%= new Date(meeting.meeting_date).toLocaleDateString('en', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></td>
        <td><span class="status-badge <%= meeting.pending_changes ? 'status-pending' : meeting.submitted_at ? 'status-active' : meeting.updated_at ? 'status-pending' : 'status-inactive' %>"><%= meeting.pending_changes ? 'Changes need submission' : meeting.submitted_at ? 'Submitted' : meeting.updated_at ? 'Changes need submission' : 'Not entered' %></span></td>
        <td><%= meeting.updated_at ? new Date(meeting.updated_at).toLocaleString() : '—' %></td>
        <td><a class="text-link" href="/subgroup/cashbook/<%= meeting.id %>"><%= meeting.updated_at ? 'Update member records →' : 'Enter member records →' %></a><a class="text-link" href="/subgroup/cashbook/<%= meeting.id %>/report.pdf">Download PDF</a></td>
      </tr><% }) %>
    </tbody></table></div>
  <% } else { %><p class="quiet-empty">Weekly Thursday meetings will appear here.</p><% } %>
</section>
<%- include('../partials/footer') %>
