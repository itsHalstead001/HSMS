<%- include('../partials/header') %>
<section class="page-heading">
  <div><span class="eyebrow">Subgroup <%= subgroupCode %> · Meeting register</span><h1><%= meeting.title %></h1><p><%= new Date(meeting.meeting_date).toLocaleString('en', { dateStyle: 'full', timeStyle: 'short' }) %></p></div>
  <a class="button button-secondary" href="/subgroup/meetings">← Attendance register</a>
</section>
<form action="/subgroup/meetings/<%= meeting.id %>" method="post" class="meeting-record-grid">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <section class="panel">
    <div class="panel-heading"><div><span class="eyebrow">Subgroup <%= subgroupCode %></span><h2>Attendance</h2></div><span class="muted"><%= members.length %> active members</span></div>
    <% if (members.length) { %><div class="attendance-list"><% members.forEach((member) => { %><div class="attendance-row"><strong><%= member.full_name %></strong><label class="sr-only" for="att-<%= member.id %>">Attendance for <%= member.full_name %></label><select id="att-<%= member.id %>" name="attendance[<%= member.id %>]"><% ['present', 'absent', 'excused'].forEach((status) => { %><option value="<%= status %>" <%= (member.status || 'absent') === status ? 'selected' : '' %>><%= status[0].toUpperCase() + status.slice(1) %></option><% }) %></select></div><% }) %></div><% } else { %><p class="quiet-empty">There are no active members in this subgroup to mark.</p><% } %>
  </section>
  <section class="panel">
    <div class="panel-heading"><div><span class="eyebrow">Subgroup records</span><h2>Meeting notes</h2></div></div>
    <div class="form-field"><label for="notes">Actions, decisions and follow-up</label><textarea id="notes" name="notes" rows="12" maxlength="10000" placeholder="Record subgroup-specific meeting notes and follow-up actions."><%= notes || '' %></textarea><small>Notes are saved with this subgroup’s meeting register.</small></div>
    <div class="form-actions"><button class="button button-primary" type="submit">Save attendance & notes</button></div>
  </section>
</form>
<%- include('../partials/footer') %>
