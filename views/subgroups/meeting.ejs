
<%- include('../partials/header') %>

<%
  const attendanceCounts = {
    present: members.filter(m => m.status === 'present').length,
    absent: members.filter(m => !m.status || m.status === 'absent').length,
    excused: members.filter(m => m.status === 'excused').length
  };
%>

<section class="page-heading">
  <div>
    <span class="eyebrow">Subgroup <%= subgroupCode %> · Meeting register</span>
    <h1><%= meeting.title %></h1>
    <p><%= new Date(meeting.meeting_date).toLocaleString('en', { dateStyle: 'full', timeStyle: 'short' }) %></p>
  </div>
  <a class="button button-secondary" href="/subgroup/meetings">← Attendance register</a>
</section>

<div class="meeting-record-grid">

  <!-- ATTENDANCE -->
  <form action="/subgroup/meetings/<%= meeting.id %>/attendance" method="post">

    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <section class="panel">

      <div class="panel-heading">
        <div>
          <span class="eyebrow">Subgroup <%= subgroupCode %></span>
          <h2>Attendance</h2>
        </div>


<div class="attendance-summary">

  <div class="attendance-summary-item">
    <strong id="present-count"><%= attendanceCounts.present %></strong>
    <span>Present</span>
  </div>

  <div class="attendance-summary-item">
    <strong id="absent-count"><%= attendanceCounts.absent %></strong>
    <span>Absent</span>
  </div>

  <div class="attendance-summary-item">
    <strong id="excused-count"><%= attendanceCounts.excused %></strong>
    <span>Excused</span>
  </div>

</div>

        <span class="muted"><%= members.length %> active members</span>
      </div>

      <% if (members.length) { %>

        <div class="attendance-list">

          <% members.forEach((member) => { %>

            <div class="attendance-row">

              <strong><%= member.full_name %></strong>

              <label class="sr-only" for="att-<%= member.id %>">
                Attendance for <%= member.full_name %>
              </label>

              <select
                id="att-<%= member.id %>"
                name="attendance[<%= member.id %>]"
                class="attendance-status-select"
                required
              >

                <% ['present', 'absent', 'excused'].forEach((status) => { %>

                  <option
                    value="<%= status %>"
                    <%= (member.status || 'absent') === status ? 'selected' : '' %>
                  >
                    <%= status[0].toUpperCase() + status.slice(1) %>
                  </option>

                <% }) %>

              </select>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <p class="quiet-empty">
          There are no active members in this subgroup to mark.
        </p>

      <% } %>

      <div class="form-actions">
        <button class="button button-primary" type="submit">
          Save attendance
        </button>
      </div>

    </section>

  </form>


  <!-- MEETING NOTES -->
  <form action="/subgroup/meetings/<%= meeting.id %>/notes" method="post">

    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <section class="panel">

      <div class="panel-heading">
        <div>
          <span class="eyebrow">Subgroup records</span>
          <h2>Meeting notes</h2>
        </div>
      </div>

      <div class="form-field">

        <label for="notes">
          Actions, decisions and follow-up
        </label>

        <textarea
          id="notes"
          name="notes"
          rows="12"
          maxlength="10000"
          placeholder="Record subgroup-specific meeting notes and follow-up actions."
        ><%= notes || '' %></textarea>

        <small>
          Notes are saved with this subgroup's meeting register.
        </small>

      </div>

      <div class="form-actions">
        <button class="button button-primary" type="submit">
          Save subgroup notes
        </button>
      </div>

    </section>

  </form>

</div>


<script>
document.addEventListener('DOMContentLoaded', function () {

  const selects = document.querySelectorAll(
    '.attendance-status-select'
  );

  function updateAttendanceCounts() {

    let present = 0;
    let absent = 0;
    let excused = 0;

    selects.forEach(function (select) {

      if (select.value === 'present') {
        present++;
      } else if (select.value === 'excused') {
        excused++;
      } else {
        absent++;
      }

    });

    document.getElementById('present-count').textContent = present;
    document.getElementById('absent-count').textContent = absent;
    document.getElementById('excused-count').textContent = excused;

  }

  selects.forEach(function (select) {
    select.addEventListener('change', updateAttendanceCounts);
  });

  updateAttendanceCounts();

});
</script>

<%- include('../partials/footer') %>
