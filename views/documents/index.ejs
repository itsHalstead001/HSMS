<%- include('../partials/header') %>
<section class="page-heading"><div><span class="eyebrow">Keep shared records close</span><h1>Group documents</h1><p>Store the constitution, signed minutes and important group documents.</p></div></section>
<div class="documents-grid">
  <section class="panel">
    <div class="panel-heading"><div><span class="eyebrow">Your library</span><h2>Saved documents</h2></div></div>
    <% if (documents.length) { %><div class="document-list"><% documents.forEach((document) => { %><div class="document-row"><span class="document-icon">▤</span><span class="document-copy"><strong><%= document.title %></strong><small><%= document.original_name %> · <%= (Number(document.file_size) / 1024).toFixed(0) %> KB · Added <%= new Date(document.created_at).toLocaleDateString() %></small></span><a class="text-link" href="/documents/<%= document.id %>/download">Download ↓</a><form action="/documents/<%= document.id %>/delete" method="post" data-confirm="Delete this document from the group library?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button danger-text" type="submit" aria-label="Delete <%= document.title %>">×</button></form></div><% }) %></div><% } else { %><p class="quiet-empty">No documents yet. Add the records your group needs to keep close.</p><% } %>
  </section>
  <form class="panel form-panel upload-panel" action="/documents" method="post" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <span class="eyebrow">Add to the library</span><h2>Upload a document</h2>
    <div class="form-field"><label for="doc-title">Document name <span class="required">*</span></label><input id="doc-title" name="title" maxlength="180" required placeholder="e.g. Group constitution"></div>
    <div class="form-field"><label for="document">Choose a file <span class="required">*</span></label><input id="document" name="document" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.txt" required><small>PDF, Word, JPG, PNG or plain text · maximum <%= maxUploadMb %> MB</small></div>
    <button class="button button-primary" type="submit">Upload document</button>
  </form>
</div>
<%- include('../partials/footer') %>
