NODE_ENV=development
PORT=3001
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=3306
DB_NAME=hsms
DB_USER=hsms_app
DB_PASSWORD=replace-with-your-local-mysql-password
DB_CONNECTION_LIMIT=10

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
UPLOAD_DIR=storage/documents
MAX_UPLOAD_MB=10

# Optional member contribution SMS notifications via Galatext.
GALATEXT_API_KEY=
GALATEXT_API_URL=https://api.galatext.com
GALATEXT_SENDER_ID=GALATEX
GALATEXT_DEFAULT_COUNTRY_CODE=254

# Initial chairperson account: set all three values before running npm run create-admin.
CHAIRPERSON_USERNAME=change-before-first-login
CHAIRPERSON_FULL_NAME=Group Chairperson
CHAIRPERSON_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
